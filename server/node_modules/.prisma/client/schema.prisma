generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  LOCAL
  GOOGLE
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model School {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id              String     @id @default(uuid())
  schoolId        String
  googleId        String?    @unique
  email           String     @unique
  password        String?
  firstName       String
  lastName        String
  avatar          String?
  provider        Provider   @default(LOCAL)
  role            Role       @default(STUDENT)
  status          UserStatus @default(ACTIVE)
  isEmailVerified Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  school         School        @relation(fields: [schoolId], references: [id])
  student        Student?
  teacher        Teacher?
  admin          Admin?
  activityLogs   ActivityLog[]
  quizzesCreated Quiz[]        @relation("QuizCreator")
}

model Student {
  id           String  @id @default(uuid())
  userId       String  @unique
  rollNumber   String  @unique
  semester     Int     @default(1)
  academicYear String?
  swbiScore    Float   @default(0.0)
  riskLevel    String  @default("low")
  teacherId    String?

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher       Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  attempts      QuizAttempt[]
  wellnessScore WellbeingScore[]
  feedback      Feedback[]       @relation("StudentFeedback")
}

model Teacher {
  id             String   @id @default(uuid())
  userId         String   @unique
  employeeId     String   @unique
  specialization String?
  joinedDate     DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]
  feedback Feedback[] @relation("TeacherFeedback")
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Quiz {
  id           String   @id @default(uuid())
  title        String
  description  String?
  topic        String
  quizType     String   @default("academic")
  difficulty   String   @default("medium")
  totalMarks   Int      @default(10)
  durationMins Int      @default(30)
  aiGenerated  Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdById  String
  createdAt    DateTime @default(now())

  createdBy User           @relation("QuizCreator", fields: [createdById], references: [id])
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id           String  @id @default(uuid())
  quizId       String
  questionText String
  questionType String  @default("mcq")
  marks        Int     @default(1)
  explanation  String?
  orderNum     Int     @default(0)

  quiz           Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  optionsList    QuizOption[]
  attemptAnswers AttemptAnswer[]
}

model QuizOption {
  id          String  @id @default(uuid())
  questionId  String
  optionText  String
  isCorrect   Boolean @default(false)
  optionLabel String?

  question       QuizQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers AttemptAnswer[]
}

model QuizAttempt {
  id            String    @id @default(uuid())
  studentId     String
  quizId        String
  score         Float     @default(0.0)
  totalMarks    Int       @default(0)
  percentage    Float     @default(0.0)
  swbiDelta     Float     @default(0.0)
  status        String    @default("in_progress")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  timeTakenSecs Int?

  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz     Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]
  feedback Feedback[]
}

model AttemptAnswer {
  id            String   @id @default(uuid())
  attemptId     String
  questionId    String
  selectedOptId String?
  isCorrect     Boolean  @default(false)
  marksAwarded  Int      @default(0)
  answeredAt    DateTime @default(now())

  attempt     QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOpt QuizOption?  @relation(fields: [selectedOptId], references: [id], onDelete: SetNull)
}

model WellbeingScore {
  id            String   @id @default(uuid())
  studentId     String
  reportDate    DateTime @default(now())
  swbiScore     Float
  academicScore Float?
  riskLevel     String   @default("low")
  aiSummary     String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Feedback {
  id           String   @id @default(uuid())
  teacherId    String
  studentId    String
  attemptId    String?
  category     String   @default("general")
  feedbackText String
  isRead       Boolean  @default(false)
  studentAck   Boolean  @default(false)
  createdAt    DateTime @default(now())

  teacher Teacher      @relation("TeacherFeedback", fields: [teacherId], references: [id], onDelete: Cascade)
  student Student      @relation("StudentFeedback", fields: [studentId], references: [id], onDelete: Cascade)
  attempt QuizAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  ipAddress String?
  device    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
